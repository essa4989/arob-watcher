# PostgreSQL connection string (Railway/Supabase/Neon or local docker-compose)
DATABASE_URL="postgresql://arob:arob_dev_password@localhost:5432/arob_watcher"

# Web server
PORT=8080
NODE_ENV=development

# JWT signing secret for session tokens — set a long random value in production
JWT_SECRET="change-me-to-a-long-random-string"

# Telegram bot (@Aruob_bot) — token from BotFather
TELEGRAM_BOT_TOKEN=""

# Default PINs for first boot only (change immediately after first login).
# Leave unset to fall back to 1234 / 5678 / 9999 as documented in the legacy system.
DEFAULT_PIN_PARENT=1234
DEFAULT_PIN_NURSE=5678
DEFAULT_PIN_DOCTOR=9999

# Comma-separated CORS origins allowed to call the API (the deployed web app URL).
# Leave empty in production when API and web are served from the same origin.
CORS_ORIGINS="http://localhost:5173"
